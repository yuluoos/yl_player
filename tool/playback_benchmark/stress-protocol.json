{
  "schemaVersion": 1,
  "id": "public-two-player-v3",
  "plannedAttempts": 3,
  "warmupAttempts": 0,
  "players": 2,
  "media": "packages/yl_player/example/assets/test_media/network_seek_h264_aac.mkv",
  "operations": [
    "create-two",
    "mount-two",
    "load-play-each",
    "pause-first",
    "seek-first-5s",
    "resume-first",
    "replace-first",
    "reject-stale-session",
    "stop-first",
    "restore-peer-explicitly",
    "verify-peer-progress",
    "stop-peer",
    "dispose-two",
    "unmount"
  ],
  "audio": "muted-app-managed",
  "cacheState": "os-cache-uncontrolled",
  "commandTimeoutSeconds": 900,
  "testTimeoutSeconds": 600,
  "presentationBoundary": "public-event-only",
  "physicalBackground": false,
  "longPlayback": false,
  "concurrentPlaybackClaim": false,
  "seekProgressWindow": {
    "boundary": "public-state",
    "targetUs": 5000000,
    "toleranceUs": 250000,
    "windowUs": 1000000,
    "maximumGapUs": 500000,
    "minimumRate": 0.5,
    "maximumRate": 1.5
  },
  "resources": {
    "intervalMs": 250,
    "beforeCreateMs": 300,
    "afterDisposeMs": 500,
    "scope": "self-process"
  }
}
